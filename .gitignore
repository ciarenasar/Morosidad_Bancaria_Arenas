data/metadata/download_manifest.jsonl
data/metadata/cmf_target_coverage.json

# Artefactos de modelos y reportes generados
models/*
!models/.gitkeep
reports/figures/*
!reports/figures/.gitkeep

# Entregables finales omitidos de esta copia
deliverables/

# Outputs temporales
*.log
mlruns/

