# Credenciales y configuración local
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Datos generados (se conservan solo marcadores y metadatos versionables)
data/raw/*
